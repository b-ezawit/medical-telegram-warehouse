  create  table "medical_db"."analytics"."fct_image_detections__dbt_tmp"
  
  
    as
  
  (
    with detections as (
    select * from "medical_db"."analytics"."stg_yolo_detections"
),

messages as (
    select 
        message_id,
        channel_key,
        date_key
    from "medical_db"."analytics"."fct_messages"
)

select
    m.message_id,
    m.channel_key,
    m.date_key,
    d.detected_class,
    d.confidence_score,
    d.image_category
from detections d
inner join messages m 
    on d.message_id = m.message_id
  );
  
